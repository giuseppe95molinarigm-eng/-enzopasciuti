  #voce[Giannopoulou C, Dudic A, Pandis N, Kiliaridis S. Slow and fast orthodontic tooth movement: an experimental study on humans. #emph[European Journal of Orthodontics.]; 2016;38(4):404–408.]
  #voce[Bertl K, Neuner H, Meran A, et al. Does the time\-point of orthodontic space closure initiation after tooth extraction affect the incidence of gingival cleft development? A randomized controlled clinical trial. #emph[Journal of Periodontology.]; 2020;91(5):572–581.]
  #voce[Küchler EC, Schröder A, Corso P, et al. Genetic polymorphisms influence gene expression of human periodontal ligament fibroblasts in the early phases of orthodontic tooth movement. #emph[Odontology.]; 2020;108:493–502.]
]

