  #voce[Shampanier K, Mazar N, Ariely D. Zero as a special price: the true value of free products. Marketing Science. 2007;26(6):742–757.]
  #voce[Baicker K, Mullainathan S, Schwartzstein J. Behavioral hazard in health insurance. Quarterly Journal of Economics. 2015;130(4):1623–1667.]
